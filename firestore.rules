rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['ADMINISTRADOR']);
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'roles', 'status'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.status in ["ATIVO", "INATIVO", "PENDENTE_VERIFICACAO"]
        && data.roles is list && data.roles.size() <= 10;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin() || request.auth != null);
      allow delete: if isSignedIn();
    }

    match /processes/{processId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /matrices/{matrixId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      
      match /rules/{ruleId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Strict audit immutability
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}

